# Track4 FoundryIQ daily leadership briefing (KST 08:30 on weekdays)
# Legacy filename: track3-daily-briefing.cron. Do not install or enable without
# human approval; the helper writes Track4 FoundryIQ output.
# If your server timezone is UTC, use: 30 23 * * 0-4
# If your server timezone is KST, use: 30 8 * * 1-5
#
# Example below assumes UTC server timezone.
# Optional Foundry refinement env:
# - AZURE_AI_FOUNDRY_RESPONSES_ENDPOINT, AZURE_AI_FOUNDRY_MODEL
# - AZURE_AI_FOUNDRY_API_KEY or AZURE_AI_FOUNDRY_BEARER_TOKEN
30 23 * * 0-4 cd /opt/data-platform-workshop && /usr/bin/python3 tools/run_track3_daily_briefing.py \
  --pipeline-version prod-2026-07 \
  --prompt-version p3.2 \
  --model-version foundry-responses-v1 \
  --toolset-version fabriciq-1.4+workiq-2.1 \
  >> /var/log/track4-foundry-daily-briefing.log 2>&1
